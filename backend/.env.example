# Copy to .env (never commit it) and fill in. All values are read from the environment.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/shady
DB_USERNAME=shady
DB_PASSWORD=change-me

# --- Security ---
# Base64 of at least 32 random bytes:  openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=https://api.shady.com
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# false only for local http development
COOKIE_SECURE=true
# Parent domain shared by the site and the API, so the frontend can read the CSRF cookie (prod: shady.com)
CSRF_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://shady.com
# Only set when the API is reachable exclusively through Cloudflare (prod default: CF-Connecting-IP)
CLIENT_IP_HEADER=

# --- Bootstrap admin (used only when no admin exists yet; remove afterwards) ---
ADMIN_EMAIL=
# 12-64 characters
ADMIN_INITIAL_PASSWORD=

# --- Login protection ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- Email (log = print to the application log; brevo/resend later) ---
MAIL_PROVIDER=log

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080
